artOfDayStr = `${datePart}T00:00:00`;\n    const endOfDayStr   = `${datePart}T23:59:59`;\n\n    // 3. Convert these NY times to UTC Epoch Ms\n    const startMs = getNyTimestamp(startOfDayStr);\n    const endMs = getNyTimestamp(endOfDayStr);\n\n    // 4. Output as Strings\n    item.json.startTimestamp = String(startMs);\n    item.json.endTimestamp = String(endMs);\n  }\n\n  return item;\n});"
